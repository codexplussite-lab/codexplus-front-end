# Copy this file to .env.local and fill in your values.
# NEXT_PUBLIC_* variables are inlined by Next.js at build time — a dev server
# restart is required after changing them.

# Sanity — public (safe to expose)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity — private (server-only, never expose in client code)
SANITY_API_TOKEN=your-api-token

# CORS: the origin "http://localhost:3000" must be allowlisted in the Sanity
# project (manage.sanity.io -> API -> CORS origins), otherwise browser requests
# (e.g. the /studio pages) will be blocked. Run `npm run check:cors` with
# SANITY_API_TOKEN set to verify.
